# Shared infrastructure: copy to `.env` (git-ignored). Docker Compose reads it by itself.
# Each app has its own settings in `apps/<app>/.env.example`; this file only holds what the
# Compose stack (PostgreSQL + Mosquitto, `pnpm docker:up`, and the optional Prometheus and Grafana of
# `pnpm docker:observe`) publishes, which every app connects to.
#
# Set everything up with:
#   for d in . apps/ingest apps/simulator; do cp -n "$d/.env.example" "$d/.env"; done

# Host ports published by Compose. Move them when something on your machine already uses one
# ("address already in use"), then use the same ports in the apps' `.env` files
# (DATABASE_URL in apps/ingest, MQTT_URL and DATABASE_URL in apps/simulator).
POSTGRES_HOST_PORT=5433
MQTT_HOST_PORT=1883
# Simulator Studio of the demo (`pnpm docker:demo`), published on localhost only. The simulator run on the
# host listens on CONTROL_PORT in apps/simulator/.env instead.
STUDIO_HOST_PORT=3200

# Only for the optional `observe` profile (`pnpm docker:observe`): Prometheus and Grafana, published on
# localhost only. A demo setting, see docs/development.md.
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# Only for the `ingest` service that Compose itself runs (`docker compose --profile demo up`): it
# delivers alerts to ops-command-center when set. All three credentials or none (ADR-0006). Inside
# a container the host is host.docker.internal; the ingest run on the host sets its own in
# apps/ingest/.env.
# OCC_API_URL=http://host.docker.internal:18080/api
# OCC_TOKEN_URL=http://host.docker.internal:18080/auth/realms/occ/protocol/openid-connect/token
# OCC_CLIENT_ID=telemetry-pipeline
# OCC_CLIENT_SECRET=
