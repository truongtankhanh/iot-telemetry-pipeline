{
  "name": "iot-telemetry-pipeline",
  "private": true,
  "description": "MQTT telemetry ingest with partitioned PostgreSQL storage, rollups, threshold alerts and reliable delivery to ops-command-center.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --filter=@itp/ingest",
    "test:e2e": "turbo run test:e2e",
    "docker:up": "bash scripts/stack.sh up",
    "docker:demo": "bash scripts/stack.sh demo",
    "docker:demo:down": "bash scripts/stack.sh demo-down",
    "docker:observe": "bash scripts/stack.sh observe",
    "docker:observe:down": "bash scripts/stack.sh observe-down",
    "docker:down": "bash scripts/stack.sh down",
    "docker:restart": "bash scripts/stack.sh restart",
    "test:ingest": "turbo run test --filter=@itp/ingest",
    "test:simulator": "turbo run test --filter=@itp/simulator",
    "test:contract": "turbo run test --filter=@itp/telemetry-contract",
    "e2e:ingest": "bash scripts/e2e-ingest.sh",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:off": "bash scripts/ci-toggle.sh off",
    "ci:on": "bash scripts/ci-toggle.sh on",
    "ci:status": "bash scripts/ci-toggle.sh status",
    "bench:gaps": "bash deploy/bench/run-gap-check.sh ok",
    "bench:gaps:loss": "bash deploy/bench/run-gap-check.sh loss",
    "bench:gaps:all": "pnpm bench:gaps && pnpm bench:gaps:loss",
    "bench:baseline": "bash deploy/bench/run-baseline.sh",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:openapi": "pnpm --filter @itp/telemetry-contract build && pnpm --filter @itp/ingest openapi:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
