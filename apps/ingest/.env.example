PORT=3100
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telemetry
MQTT_URL=mqtt://localhost:1883
MQTT_SHARE_GROUP=ingest
# Several connections per replica, for brokers that cap delivery per connection (AWS IoT Core)
# MQTT_CONNECTIONS=1
# Mutual TLS (AWS IoT Core: MQTT_URL=mqtts://<endpoint>:8883); PEM text, `\n` escapes allowed
# MQTT_CA_PEM=
# MQTT_CERT_PEM=
# MQTT_KEY_PEM=
FLUSH_INTERVAL_MS=250
FLUSH_MAX_READINGS=1000
RETENTION_DAYS=30
# Deliver alerts to ops-command-center (leave unset to only record them)
# OCC_API_URL=http://localhost:3000/api
