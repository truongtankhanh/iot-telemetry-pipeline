# Settings of the ingest service run on the host (`pnpm --filter @itp/ingest dev|start`): copy to
# `.env` in this directory (git-ignored). Compose, the e2e suite and the other app have their own.
# docs/configuration.md describes every variable; those left commented keep the default shown.

PORT=3100
# OpenAPI UI at /api/docs; off by default, on for local development
API_DOCS_ENABLED=true
# Log lines as readable text (default) or one JSON object per line (the container image sets json)
# LOG_FORMAT=text
# PostgreSQL and Mosquitto from `pnpm docker:up`; use the ports of POSTGRES_HOST_PORT and
# MQTT_HOST_PORT in the root `.env` if you moved them.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/telemetry
# Connections this process may hold open to PostgreSQL (2-100); a connection budget, not a speed setting
# DB_POOL_MAX=10
# Cancel a statement that runs longer than this many ms (0-3600000); 0 sets nothing. Migrations and
# partition maintenance exempt themselves. A few hundred ms or less would cancel ordinary flushes
# DB_STATEMENT_TIMEOUT_MS=0
MQTT_URL=mqtt://localhost:1883
MQTT_SHARE_GROUP=ingest
# Broker credentials, if it requires them (the Compose Mosquitto allows anonymous clients)
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Client ids are <prefix>-<instance>-<n>, so a broker policy can allow <prefix>-*
# MQTT_CLIENT_ID_PREFIX=ingest
# Several connections per replica, for brokers that cap delivery per connection (AWS IoT Core)
# MQTT_CONNECTIONS=1
# Mutual TLS (AWS IoT Core: MQTT_URL=mqtts://<endpoint>:8883); PEM text, `\n` escapes allowed
# MQTT_CA_PEM=
# MQTT_CERT_PEM=
# MQTT_KEY_PEM=
FLUSH_INTERVAL_MS=250
FLUSH_MAX_READINGS=1000
# Readings held in memory before the consumer stops acknowledging (a database outage then queues at the broker)
# BUFFER_MAX_READINGS=20000
# A sequence gap counts as lost after this long, so late messages can still fill it
# SEQUENCE_GRACE_MS=30000
RETENTION_DAYS=30
# Directory holding devices.json and rules.json
# CONFIG_DIR=config
# Apply database migrations at start (several replicas serialise on an advisory lock)
# MIGRATE_ON_BOOT=true

# Deliver alerts to ops-command-center (leave unset to only record them)
# OCC_API_URL=http://localhost:18080/api
# Client credentials for its Keycloak (ADR-0006): all three or none
# OCC_TOKEN_URL=http://localhost:18080/auth/realms/occ/protocol/openid-connect/token
# OCC_CLIENT_ID=telemetry-pipeline
# OCC_CLIENT_SECRET=
# How often the alert outbox is delivered (ms)
# DELIVERY_INTERVAL_MS=1000
