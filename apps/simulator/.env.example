# Settings of the simulator (`pnpm --filter @itp/simulator start|bench`): copy to `.env` in this
# directory (git-ignored). Command-line options (--broker, --database) override these.

# Broker to publish to: the Mosquitto from `pnpm docker:up`. Use the port of MQTT_HOST_PORT in the
# root `.env` if you moved it.
MQTT_URL=mqtt://localhost:1883
# Only `bench` reads the database (it counts the readings that arrived): the PostgreSQL from
# `pnpm docker:up`, port POSTGRES_HOST_PORT in the root `.env`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/telemetry
