# Settings of the simulator (`pnpm --filter @itp/simulator start|bench`): copy to `.env` in this
# directory (git-ignored). Command-line options (--broker, --database, --control-host, --control-port,
# --ingest-url, --studio-dir, --scenarios-dir, --rules) override these; --simulated-clock only adds to
# SIMULATED_CLOCK (see below).

# Broker to publish to: the Mosquitto from `pnpm docker:up`. Use the port of MQTT_HOST_PORT in the
# root `.env` if you moved it.
MQTT_URL=mqtt://localhost:1883
# Only `bench` reads the database (it counts the readings that arrived): the PostgreSQL from
# `pnpm docker:up`, port POSTGRES_HOST_PORT in the root `.env`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/telemetry

# The control server of Simulator Studio, run by `start` (`--no-control` turns it off): see the
# "Control server" section of the README. It has no authentication, so it listens on this machine only.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=3200
# Ingest, which the control server reads (readiness, alerts, metrics). Use the address of the ingest
# service you run.
INGEST_URL=http://localhost:3100
# Base URL of the command center console, for the incident link in the UI. Empty: no link.
OCC_CONSOLE_URL=
# Directory of the built Studio UI (`pnpm --filter @itp/simulator-ui build`) that the control server serves
# at `/`. Default: apps/simulator-ui/dist. A directory that is not built is not an error.
# STUDIO_DIR=
# The ingest's rules.json, which Studio draws the raise and clear lines and the range bars from. Default:
# apps/ingest/config/rules.json. A file that cannot be read or is invalid is not an error: the simulator says so
# at start and Studio hides what depends on it.
# RULES_FILE=
# Folder of custom scenario files (*.json), read once at start by the control server. Default:
# apps/simulator/scenarios. A missing folder means no custom scenarios; a file that cannot be used is
# listed at start-up with its reason and is not played. It is not in the container image.
# SCENARIOS_DIR=
# Run on the simulated clock (`start` only; `bench` ignores it): one tick is sent at start and then a tick
# only when Studio's Step (POST /api/step) moves the clock, so nothing is published by itself. It needs the
# control server (with --no-control it is refused). `ts` follows the simulated clock from the wall time of
# the start; ingest rejects a `ts` more than 5 minutes ahead of its own clock (`future`). Only the exact
# value `true` turns it on, and --simulated-clock turns it on too; to go back, unset it. Default: unset.
# SIMULATED_CLOCK=true
# Any address that is not loopback (0.0.0.0, a LAN address) is refused unless this is exactly `true`.
# Leave it unset on a laptop: it exposes an unauthenticated control API to the network.
# CONTROL_ALLOW_NON_LOOPBACK=true
